#

from setuptools import setup, Extension
import sys

package = "@PACKAGE@".lower()
data_files = []
cflags = "@CFLAGS@".split()
include_dirs = ["@top_srcdir@/include"]
library_dirs = ["@top_builddir@/lib/.libs"]
libraries = ["tre"]

if sys.platform == "win32":
    data_files = ["@top_builddir@/win32/Release/tre.dll"]
    libraries = ["../win32/Release/tre"]

setup(name = package,
      version = "@VERSION@",
      description = "Python module for TRE",
      author = "Ville Laurikari",
      author_email = "@PACKAGE_BUGREPORT@",
      license = "2-clause BSD",
      url = "@PACKAGE_URL@",
      data_files = data_files,
      ext_modules = [Extension(package,
                               sources = ["tre-python.c"],
                               extra_compile_args = cflags,
                               define_macros = [("TRE_MODULE", f'"{package}"')],
                               include_dirs = include_dirs,
                               library_dirs = library_dirs,
                               libraries = libraries
                               ),
                     ],
      )
